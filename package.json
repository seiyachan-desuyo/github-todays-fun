{
  "name": "github-today-fun",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.34.5",
  "scripts": {
    "dev": "next dev",
    "build": "pnpm feed:generate && next build",
    "start": "next start",
    "lint": "next lint",
    "test": "vitest run",
    "collect": "tsx scripts/collect-editor-task.ts",
    "validate:edition": "tsx scripts/validate-edition.ts",
    "feed:generate": "tsx scripts/generate-feed.ts",
    "pipeline:prepare": "tsx scripts/daily-pipeline.ts prepare",
    "pipeline:stage": "tsx scripts/daily-pipeline.ts stage",
    "pipeline:finalize": "tsx scripts/daily-pipeline.ts finalize",
    "pipeline:status": "tsx scripts/daily-pipeline.ts status",
    "pipeline:success": "tsx scripts/daily-pipeline.ts success",
    "bot:send": "tsx scripts/send-lark-daily.ts",
    "aime:package": "bash scripts/package-aime-app.sh",
    "refresh": "pnpm pipeline:prepare"
