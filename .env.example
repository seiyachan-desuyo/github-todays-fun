# GitHub official APIs (optional locally, strongly recommended in production)
GITHUB_TOKEN=

# Optional collection/validation overrides
EDITION_DATE=

# Deployment token (optional; only used by the deploy command, not by pipeline:success)
VERCEL_TOKEN=
# NOTE: pipeline:success no longer performs an online (IDA) availability check, so it no
# longer reads PIPELINE_SUCCESS_AUTHORIZATION. It now verifies the local build artifact
# (dist/data/feed.json -> public/data/feed.json) `latest` field equals the target date.

# Standalone Feishu bot (required only for pnpm bot:send; keep secrets out of Git)
LARK_APP_ID=
LARK_APP_SECRET=
LARK_RECIPIENT_ID=
LARK_RECIPIENT_ID_TYPE=open_id
GITHUB_TODAY_WEBSITE_URL=https://1384e82de8f4.ida-app.bytedance.net
# Optional Aime runtime feed override; defaults to the public GitHub Raw feed.
GITHUB_TODAY_FEED_URL=
LARK_HIGHLIGHT_COUNT=5
